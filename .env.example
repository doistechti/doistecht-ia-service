# Copie este arquivo para .env e preencha os valores.
# O arquivo .env NÃO deve ser commitado.

# Chave do Google AI Studio: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Modelo Gemini usado no chat (opcional, padrão: gemini-2.5-flash)
GEMINI_MODEL=gemini-2.5-flash

# Modelo reserva, usado quando o principal está fora do ar ou sem cota (opcional; vazio desativa)
GEMINI_FALLBACK_MODEL=gemini-2.5-flash-lite

# Tempo máximo de cada chamada ao Gemini (opcional, padrão: 30s)
GEMINI_TIMEOUT=30s

# Chave de administrador, exigida nas rotas /v1/admin/** (cadastro de clientes, templates e uso).
# Os projetos clientes usam chaves próprias, geradas em POST /v1/admin/clients.
# Gere uma chave aleatória, ex.: openssl rand -hex 32
IA_SERVICE_ADMIN_KEY=

# Banco de dados (opcional; os valores abaixo são os padrões).
# No docker compose, a URL do banco é montada automaticamente.
DB_NAME=ia_service
DB_USERNAME=ia_service
DB_PASSWORD=ia_service

# Cache de respostas no Redis (opcional)
RESPONSE_CACHE_ENABLED=true
RESPONSE_CACHE_TTL=1h
